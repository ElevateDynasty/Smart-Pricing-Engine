# =============================================================================
# AI Smart Pricing Engine — .gitignore
# =============================================================================

# ---- Security, Secrets & API Credentials (NEVER COMMIT) ----
.env
.env.*
*.env
*.key
*.pem
*.pfx
*.p12
*.token
*secret*
*credential*
kaggle.json
.kaggle/
.streamlit/secrets.toml

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
*.so

# ---- Virtual environments ----
venv/
env/
.venv/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*.code-workspace

# ---- Generated data files & raw downloads ----
data/raw/
data/processed/
*.zip
*.tar.gz

# ---- Trained model artifacts & binaries ----
models_saved/
models/
*.joblib
*.pkl
*.pickle
*.h5
*.onnx

# ---- Reports & logs ----
reports/figures/*.png
reports/figures/*.html
*.log

# ---- OS files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Jupyter & Testing ----
.ipynb_checkpoints/
.pytest_cache/

# ---- Streamlit ----
.streamlit/

# ---- Non-project / working folders ----
Basic/
Pre Implementation Plan/
implementation_plan.md
_legacy_archive/
*.tex
*.aux
*.synctex.gz
*.fls
*.fdb_latexmk
*.out
*.toc
*.docx

